# Copy to .env and fill in. Never commit the real .env.

# Required: key for the OpenAI-compatible multimodal API used by the
# refine (Stage 1b) and instruction (Level 1/2/3) stages.
# Falls back to GEMINI_API_KEY, then GOOGLE_API_KEY, if this is unset.
OPENAI_API_KEY=

# Endpoint for the OpenAI-compatible API.
# If left unset, the client defaults to api.openai.com — in which case you MUST
# also override the model names, because the shipped defaults
# (gemini-2.5-flash / gemini-3.5-flash) are not served there. See README.
# OPENAI_BASE_URL=https://your-gateway/v1

# Optional caching / throughput tuning (useful for networked storage).
# OWA_LOCAL_VIDEO_CACHE_DIR=/local/scratch/video-cache
# OWA_LOCAL_FRAME_CACHE_DIR=/local/scratch/frame-cache
# OWA_VIDEO_PTS_CACHE_DIR=/local/scratch/pts-cache
# OWA_LEVEL1_SPARSE_JOBS=1
# OWA_LEVEL1_FFMPEG_THREADS=0
